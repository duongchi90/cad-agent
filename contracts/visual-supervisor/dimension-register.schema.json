{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/visual-supervisor/dimension-register.schema.json",
  "title": "Visual Supervisor Dimension Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_sha256",
    "page_id",
    "view_id",
    "coverage",
    "summary",
    "dimensions"
  ],
  "properties": {
    "schema_version": {"const": "dimension-register-1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "view_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusters_detected", "clusters_processed", "page_coverage_percent"],
      "properties": {
        "clusters_detected": {"type": "integer", "minimum": 0},
        "clusters_processed": {"type": "integer", "minimum": 0},
        "page_coverage_percent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "unresolved", "conflicts"],
      "properties": {
        "confirmed": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "conflicts": {"type": "integer", "minimum": 0}
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_text",
          "value",
          "unit",
          "kind",
          "role",
          "status",
          "critical",
          "source_evidence",
          "text_confidence",
          "attachment_confidence",
          "blocker_scope"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "display_text": {"type": "string"},
          "value": {"type": ["number", "null"]},
          "unit": {
            "anyOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "kind": {"type": "string", "minLength": 1},
          "role": {
            "type": "string",
            "enum": ["DRIVING", "REFERENCE", "DERIVED", "AMBIGUOUS", "CONFLICT"]
          },
          "status": {"type": "string", "enum": ["CONFIRMED", "UNRESOLVED", "CONFLICT"]},
          "critical": {"type": "boolean"},
          "from_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id"],
            "properties": {
              "type": {"type": "string", "enum": ["DATUM", "ENTITY", "FEATURE", "DIMENSION"]},
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
              "entity_handle": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}
            },
            "allOf": [
              {
                "if": {"properties": {"type": {"const": "DATUM"}}, "required": ["type"]},
                "then": {},
                "else": {"not": {"required": ["entity_handle"]}}
              }
            ]
          },
          "to_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id"],
            "properties": {
              "type": {"type": "string", "enum": ["DATUM", "ENTITY", "FEATURE", "DIMENSION"]},
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
              "entity_handle": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}
            },
            "allOf": [
              {
                "if": {"properties": {"type": {"const": "DATUM"}}, "required": ["type"]},
                "then": {},
                "else": {"not": {"required": ["entity_handle"]}}
              }
            ]
          },
          "source_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["crop_id", "bbox", "crop_sha256"],
            "properties": {
              "crop_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
              "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
              "crop_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "text_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "attachment_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "blocker_scope": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}
          },
          "raw_text_candidates": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "ocr_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "content", "bbox", "rotation_deg", "confidence", "source"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
                "content": {"type": "string"},
                "bbox": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {"type": "number"}
                },
                "rotation_deg": {"type": "number", "enum": [-90, 0, 90]},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "source": {"type": "string", "minLength": 1}
              }
            }
          },
          "symbol_text": {
            "anyOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "tolerance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "upper", "lower", "unit"],
            "properties": {
              "mode": {"enum": ["NONE", "SYMMETRIC", "LIMITS", "PLUS_MINUS"]},
              "upper": {"type": ["number", "null"]},
              "lower": {"type": ["number", "null"]},
              "unit": {
                "anyOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "null"}
                ]
              }
            }
          },
          "extension_geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension_line", "extension_lines", "arrow_points", "leader_lines"],
            "properties": {
              "dimension_line": {
                "anyOf": [
                  {"type": "null"},
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {"type": "number"}
                    }
                  }
                ]
              },
              "extension_lines": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number"}
                  }
                }
              },
              "arrow_points": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {"type": "number"}
                }
              },
              "leader_lines": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number"}
                  }
                }
              }
            }
          },
          "attachment_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from_ref", "to_ref", "confidence", "evidence"],
              "properties": {
                "from_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "id"],
                  "properties": {
                    "type": {"type": "string", "enum": ["DATUM", "ENTITY", "FEATURE", "DIMENSION"]},
                    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}
                  }
                },
                "to_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "id"],
                  "properties": {
                    "type": {"type": "string", "enum": ["DATUM", "ENTITY", "FEATURE", "DIMENSION"]},
                    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}
                  }
                },
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observer_version", "ocr_engine", "ocr_rotations_deg", "observation_sha256"],
            "properties": {
              "observer_version": {"type": "string", "minLength": 1},
              "ocr_engine": {"type": "string", "minLength": 1},
              "ocr_rotations_deg": {"const": [0.0, 90.0, -90.0]},
              "observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"const": "CONFIRMED"}},
              "required": ["status"]
            },
            "then": {"properties": {"value": {"type": "number"}}}
          },
          {
            "if": {
              "properties": {"status": {"const": "CONFIRMED"}},
              "required": ["status"]
            },
            "then": {
              "properties": {
                "display_text": {"type": "string", "minLength": 1},
                "unit": {"type": "string", "minLength": 1}
              }
            }
          },
          {
            "if": {
              "properties": {"role": {"const": "DRIVING"}, "status": {"const": "CONFIRMED"}},
              "required": ["role", "status"]
            },
            "then": {"required": ["from_ref", "to_ref"]}
          },
          {
            "if": {
              "properties": {"critical": {"const": true}, "status": {"enum": ["UNRESOLVED", "CONFLICT"]}},
              "required": ["critical", "status"]
            },
            "then": {"properties": {"blocker_scope": {"minItems": 1}}}
          },
          {
            "if": {"properties": {"role": {"const": "CONFLICT"}}, "required": ["role"]},
            "then": {"properties": {"status": {"const": "CONFLICT"}}}
          },
          {
            "if": {"properties": {"role": {"const": "AMBIGUOUS"}}, "required": ["role"]},
            "then": {"properties": {"status": {"enum": ["UNRESOLVED", "CONFLICT"]}}}
          }
        ]
      }
    }
  }
}
