{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/template-manifest-1.0",
  "title": "Template Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "file_name",
    "file_sha256",
    "drawing_profile_sha256",
    "embedded_settings_sha256",
    "status",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "template-manifest-1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "file_name": {
      "type": "string",
      "pattern": "^[^\\\\/]+\\.dwt$"
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "drawing_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "embedded_settings_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "APPROVED"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "approved_by"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
