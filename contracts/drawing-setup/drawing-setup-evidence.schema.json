{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/drawing-setup-evidence-1.0",
  "title": "Drawing Setup Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "run_id",
    "setup_plan_sha256",
    "audit_sha256",
    "drawing_profile_sha256",
    "template_file_sha256",
    "blockers",
    "verified_by",
    "approval_reference"
  ],
  "properties": {
    "schema_version": {
      "const": "drawing-setup-evidence-1.0"
    },
    "status": {
      "enum": [
        "SETUP_VERIFIED",
        "NEEDS_REVIEW"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "setup_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audit_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "drawing_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "template_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "expected",
          "actual",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "expected": {},
          "actual": {},
          "severity": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verified_by": {
      "type": "string",
      "minLength": 1
    },
    "approval_reference": {
      "type": "string",
      "minLength": 1
    },
    "expectation_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_scope": {
      "enum": [
        "GATING_ONLY",
        "NO_CONFORMANCE_ASSERTION"
      ]
    },
    "verification_reason": {
      "type": "string",
      "minLength": 1
    },
    "gating_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "variables.INSUNITS",
          "variables.MEASUREMENT",
          "variables.LTSCALE",
          "variables.CELTSCALE",
          "variables.PSLTSCALE",
          "variables.MSLTSCALE",
          "variables.DIMASSOC",
          "variables.ANNOALLVISIBLE",
          "current_layer",
          "required_layers",
          "required_styles",
          "layouts",
          "font_policy",
          "embedded_settings"
        ]
      }
    },
    "evaluated_gating_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "variables.INSUNITS",
          "variables.MEASUREMENT",
          "variables.LTSCALE",
          "variables.CELTSCALE",
          "variables.PSLTSCALE",
          "variables.MSLTSCALE",
          "variables.DIMASSOC",
          "variables.ANNOALLVISIBLE",
          "current_layer",
          "required_layers",
          "required_styles",
          "layouts",
          "font_policy",
          "embedded_settings"
        ]
      }
    },
    "observation_only_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "variables.INSUNITS",
          "variables.MEASUREMENT",
          "variables.LTSCALE",
          "variables.CELTSCALE",
          "variables.PSLTSCALE",
          "variables.MSLTSCALE",
          "variables.DIMASSOC",
          "variables.ANNOALLVISIBLE",
          "current_layer",
          "required_layers",
          "required_styles",
          "layouts",
          "font_policy",
          "embedded_settings"
        ]
      }
    },
    "unresolved_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "variables.INSUNITS",
          "variables.MEASUREMENT",
          "variables.LTSCALE",
          "variables.CELTSCALE",
          "variables.PSLTSCALE",
          "variables.MSLTSCALE",
          "variables.DIMASSOC",
          "variables.ANNOALLVISIBLE",
          "current_layer",
          "required_layers",
          "required_styles",
          "layouts",
          "font_policy",
          "embedded_settings"
        ]
      }
    },
    "observation_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "observed_value",
          "comparison",
          "conformance"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "variables.INSUNITS",
              "variables.MEASUREMENT",
              "variables.LTSCALE",
              "variables.CELTSCALE",
              "variables.PSLTSCALE",
              "variables.MSLTSCALE",
              "variables.DIMASSOC",
              "variables.ANNOALLVISIBLE",
              "current_layer",
              "required_layers",
              "required_styles",
              "layouts",
              "font_policy",
              "embedded_settings"
            ]
          },
          "observed_value": {},
          "comparison": {
            "const": "NOT_EVALUATED"
          },
          "conformance": {
            "const": "NOT_ASSERTED"
          }
        }
      }
    },
    "conformance_assertion": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SETUP_VERIFIED"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "blockers": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "expectation_policy_sha256"
            ]
          },
          {
            "required": [
              "verification_scope"
            ]
          },
          {
            "required": [
              "gating_paths"
            ]
          },
          {
            "required": [
              "evaluated_gating_paths"
            ]
          },
          {
            "required": [
              "observation_only_paths"
            ]
          },
          {
            "required": [
              "unresolved_paths"
            ]
          },
          {
            "required": [
              "observation_records"
            ]
          },
          {
            "required": [
              "conformance_assertion"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "expectation_policy_sha256",
          "verification_scope",
          "gating_paths",
          "evaluated_gating_paths",
          "observation_only_paths",
          "unresolved_paths",
          "observation_records",
          "conformance_assertion"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "SETUP_VERIFIED"
                }
              }
            },
            "then": {
              "properties": {
                "verification_scope": {
                  "const": "GATING_ONLY"
                },
                "gating_paths": {
                  "type": "array",
                  "minItems": 1
                },
                "evaluated_gating_paths": {
                  "type": "array",
                  "minItems": 1
                },
                "conformance_assertion": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NEEDS_REVIEW"
                }
              }
            },
            "then": {
              "properties": {
                "conformance_assertion": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "allOf": [
                {
                  "properties": {
                    "status": {
                      "const": "NEEDS_REVIEW"
                    }
                  }
                },
                {
                  "properties": {
                    "verification_scope": {
                      "const": "GATING_ONLY"
                    }
                  }
                }
              ]
            },
            "then": {
              "properties": {
                "blockers": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "observation_only_paths": {
                  "type": "array",
                  "minItems": 1
                }
              }
            },
            "then": {
              "properties": {
                "observation_records": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "verification_scope": {
                  "const": "GATING_ONLY"
                }
              }
            },
            "then": {
              "properties": {
                "gating_paths": {
                  "type": "array",
                  "minItems": 1
                },
                "evaluated_gating_paths": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "verification_scope": {
                  "const": "NO_CONFORMANCE_ASSERTION"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": "NEEDS_REVIEW"
                },
                "gating_paths": {
                  "type": "array",
                  "maxItems": 0
                },
                "evaluated_gating_paths": {
                  "type": "array",
                  "maxItems": 0
                },
                "conformance_assertion": {
                  "const": false
                },
                "verification_reason": {
                  "const": "EMPTY_GATING_SCOPE"
                }
              },
              "required": [
                "verification_reason"
              ]
            }
          }
        ]
      }
    }
  ]
}
