{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/drawing-setup-plan-1.0",
  "title": "Drawing Setup Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "state",
    "definition",
    "drawing_profile",
    "domain_pack",
    "template",
    "setup_expectations"
  ],
  "properties": {
    "schema_version": {
      "const": "drawing-setup-plan-1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "state": {
      "const": "SETUP_PENDING"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "drawing_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "domain_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "file_sha256",
        "embedded_settings_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "embedded_settings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "setup_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variables",
        "current_layer",
        "required_layers",
        "required_styles",
        "layouts",
        "font_policy"
      ],
      "properties": {
        "variables": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "INSUNITS",
            "MEASUREMENT",
            "LTSCALE",
            "CELTSCALE",
            "PSLTSCALE",
            "MSLTSCALE",
            "DIMASSOC",
            "ANNOALLVISIBLE"
          ],
          "properties": {
            "INSUNITS": {
              "type": "number"
            },
            "MEASUREMENT": {
              "type": "number"
            },
            "LTSCALE": {
              "type": "number"
            },
            "CELTSCALE": {
              "type": "number"
            },
            "PSLTSCALE": {
              "type": "number"
            },
            "MSLTSCALE": {
              "type": "number"
            },
            "DIMASSOC": {
              "type": "number"
            },
            "ANNOALLVISIBLE": {
              "type": "number"
            }
          }
        },
        "current_layer": {
          "type": "string",
          "minLength": 1
        },
        "required_layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "linetype",
              "plottable"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "linetype": {
                "type": "string",
                "minLength": 1
              },
              "plottable": {
                "type": "boolean"
              }
            }
          }
        },
        "required_styles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "dimension",
            "mleader",
            "table"
          ],
          "properties": {
            "text": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dimension": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mleader": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "table": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "layouts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "viewport_scales",
              "locked"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "viewport_scales": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "locked": {
                "type": "boolean"
              }
            }
          }
        },
        "font_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_mode",
            "new_drawing",
            "legacy_compatibility"
          ],
          "properties": {
            "selected_mode": {
              "enum": [
                "NEW_DRAWING",
                "LEGACY_COMPATIBILITY"
              ]
            },
            "new_drawing": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "approved_fonts",
                "substitution_allowed"
              ],
              "properties": {
                "approved_fonts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "substitution_allowed": {
                  "const": false
                }
              }
            },
            "legacy_compatibility": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "preserve_source_styles",
                "mapping_report_required"
              ],
              "properties": {
                "preserve_source_styles": {
                  "const": true
                },
                "mapping_report_required": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  }
}
