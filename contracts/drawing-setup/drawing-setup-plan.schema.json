{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/drawing-setup-plan-1.0",
  "title": "Drawing Setup Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "state",
    "definition",
    "drawing_profile",
    "domain_pack",
    "template",
    "setup_expectations"
  ],
  "properties": {
    "schema_version": {
      "const": "drawing-setup-plan-1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "state": {
      "const": "SETUP_PENDING"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "drawing_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "domain_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "file_sha256",
        "embedded_settings_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "embedded_settings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "setup_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variables",
        "current_layer",
        "required_layers",
        "required_styles",
        "layouts",
        "font_policy"
      ],
      "properties": {
        "variables": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "INSUNITS",
            "MEASUREMENT",
            "LTSCALE",
            "CELTSCALE",
            "PSLTSCALE",
            "MSLTSCALE",
            "DIMASSOC",
            "ANNOALLVISIBLE"
          ],
          "properties": {
            "INSUNITS": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "UNRESOLVED"
                }
              ]
            },
            "MEASUREMENT": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "UNRESOLVED"
                }
              ]
            },
            "LTSCALE": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "UNRESOLVED"
                }
              ]
            },
            "CELTSCALE": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "UNRESOLVED"
                }
              ]
            },
            "PSLTSCALE": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "UNRESOLVED"
                }
              ]
            },
            "MSLTSCALE": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "UNRESOLVED"
                }
              ]
            },
            "DIMASSOC": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "UNRESOLVED"
                }
              ]
            },
            "ANNOALLVISIBLE": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "UNRESOLVED"
                }
              ]
            }
          }
        },
        "current_layer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "const": "UNRESOLVED"
            }
          ]
        },
        "required_layers": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "linetype",
                  "plottable"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "linetype": {
                    "type": "string",
                    "minLength": 1
                  },
                  "plottable": {
                    "type": "boolean"
                  }
                }
              }
            },
            {
              "const": "UNRESOLVED"
            }
          ]
        },
        "required_styles": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "dimension",
                "mleader",
                "table"
              ],
              "properties": {
            "text": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dimension": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mleader": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "table": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
              }
            },
            {
              "const": "UNRESOLVED"
            }
          ]
        },
        "layouts": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "viewport_scales",
                  "locked"
                ],
                "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "viewport_scales": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "locked": {
                "type": "boolean"
              }
                }
              }
            },
            {
              "const": "UNRESOLVED"
            }
          ]
        },
        "font_policy": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selected_mode",
                "new_drawing",
                "legacy_compatibility"
              ],
              "properties": {
            "selected_mode": {
              "enum": [
                "NEW_DRAWING",
                "LEGACY_COMPATIBILITY"
              ]
            },
            "new_drawing": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "approved_fonts",
                "substitution_allowed"
              ],
              "properties": {
                "approved_fonts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "substitution_allowed": {
                  "const": false
                }
              }
            },
            "legacy_compatibility": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "preserve_source_styles",
                "mapping_report_required"
              ],
              "properties": {
                "preserve_source_styles": {
                  "const": true
                },
                "mapping_report_required": {
                  "const": true
                }
              }
            }
              }
            },
            {
              "const": "UNRESOLVED"
            }
          ]
        }
      }
    },
    "expectation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "default_mode",
        "field_modes"
      ],
      "properties": {
        "schema_version": {
          "const": "drawing-setup-expectation-policy-1.0"
        },
        "default_mode": {
          "const": "GATING"
        },
        "field_modes": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "variables.INSUNITS",
              "variables.MEASUREMENT",
              "variables.LTSCALE",
              "variables.CELTSCALE",
              "variables.PSLTSCALE",
              "variables.MSLTSCALE",
              "variables.DIMASSOC",
              "variables.ANNOALLVISIBLE",
              "current_layer",
              "required_layers",
              "required_styles",
              "layouts",
              "font_policy",
              "embedded_settings"
            ]
          },
          "additionalProperties": {
            "enum": [
              "GATING",
              "OBSERVATION_ONLY"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "expectation_policy"
        ],
        "properties": {
          "expectation_policy": {
            "required": [
              "field_modes"
            ],
            "properties": {
              "field_modes": {
                "required": [
                  "variables.INSUNITS"
                ],
                "properties": {
                  "variables.INSUNITS": {
                    "const": "OBSERVATION_ONLY"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "properties": {
            "setup_expectations": {
              "properties": {
                "variables": {
                  "properties": {
                    "INSUNITS": {
                      "const": "UNRESOLVED"
                    }
                  }
                }
              }
            }
          }
        }
      }
