{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/drawing-setup-audit-1.0",
  "title": "Drawing Setup Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "drawing_full_path",
    "drawing_sha256",
    "changed",
    "dbmod_before",
    "dbmod_after",
    "variables",
    "current_layer",
    "custom_properties",
    "layers",
    "styles",
    "layouts",
    "font_report"
  ],
  "properties": {
    "schema_version": {
      "const": "drawing-setup-audit-1.0"
    },
    "drawing_full_path": {
      "type": "string",
      "minLength": 1
    },
    "drawing_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changed": {
      "type": "boolean"
    },
    "dbmod_before": {
      "type": "integer"
    },
    "dbmod_after": {
      "type": "integer"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "current_layer": {
      "type": "string",
      "minLength": 1
    },
    "custom_properties": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "linetype",
          "plottable"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "linetype": {
            "type": "string",
            "minLength": 1
          },
          "plottable": {
            "type": "boolean"
          }
        }
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "dimension",
        "mleader",
        "table"
      ],
      "properties": {
        "text": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 0
          }
        },
        "dimension": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mleader": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "table": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "viewport_scales",
          "locked"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "viewport_scales": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "locked": {
            "type": "boolean"
          }
        }
      }
    },
    "font_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing",
        "substituted"
      ],
      "properties": {
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "substituted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_space_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drawing_full_path", "drawing_sha256_before", "drawing_sha256_after",
        "dbmod_before", "dbmod_after", "process_id", "plugin_version",
        "plugin_binary_path", "plugin_binary_sha256", "entity_count",
        "enumeration_complete", "bounds_complete", "entities"
      ],
      "properties": {
        "drawing_full_path": { "type": "string", "minLength": 1 },
        "drawing_sha256_before": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "drawing_sha256_after": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "dbmod_before": { "const": 0 },
        "dbmod_after": { "const": 0 },
        "process_id": { "type": "integer", "minimum": 1 },
        "plugin_version": { "type": "string", "minLength": 1 },
        "plugin_binary_path": { "type": "string", "minLength": 1 },
        "plugin_binary_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "entity_count": { "type": "integer", "minimum": 0, "maximum": 50000 },
        "enumeration_complete": { "const": true },
        "bounds_complete": { "type": "boolean" },
        "entities": {
          "type": "array", "maxItems": 50000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["handle", "type", "bounds_status", "bounds"],
            "properties": {
              "handle": { "type": "string", "pattern": "^[0-9A-Fa-f]+$" },
              "type": { "type": "string", "minLength": 1 },
              "bounds_status": { "enum": ["BOUNDS_READ", "UNSUPPORTED", "UNREADABLE", "NONFINITE"] },
              "bounds": {
                "anyOf": [
                  { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" } },
                  { "type": "null" }
                ]
              }
            }
          }
        }
      }
    }
  }
}
