{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/marine-knowledge-pack-1.0",
  "title": "Marine Knowledge Pack Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "status",
    "cad_mutation",
    "default_core_behavior_changed",
    "domain_pack_compatibility",
    "domains",
    "drawing_types",
    "vocabulary",
    "source_manifest_sha256",
    "terms",
    "rules",
    "pack_sha256"
  ],
  "properties": {
    "schema_version": { "const": "marine-knowledge-pack-1.0" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "revision": { "type": "string", "minLength": 1 },
    "status": { "enum": ["CANDIDATE_UNAPPROVED", "DRAFT_REVIEW_ONLY"] },
    "cad_mutation": { "const": false },
    "default_core_behavior_changed": { "const": false },
    "domain_pack_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_schema", "promotable", "requires_human_approval", "approved_by"],
      "properties": {
        "target_schema": { "const": "domain-pack-1.0" },
        "promotable": { "type": "boolean" },
        "requires_human_approval": { "const": true },
        "approved_by": { "type": "null" }
      }
    },
    "domains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "drawing_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "vocabulary": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "terms": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term_id",
          "canonical_name_vi",
          "canonical_name_en",
          "aliases",
          "category",
          "source_id",
          "source_version",
          "clause",
          "pdf_page",
          "reg_page",
          "verbatim_excerpt",
          "applicable_drawing_types",
          "approval_status"
        ],
        "properties": {
          "term_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "canonical_name_vi": { "type": "string", "minLength": 1 },
          "canonical_name_en": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "category": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "source_version": { "type": "string", "minLength": 1 },
          "clause": { "type": "string", "minLength": 1 },
          "pdf_page": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "reg_page": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "verbatim_excerpt": { "type": "string", "minLength": 1 },
          "applicable_drawing_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "approval_status": { "enum": ["CANDIDATE_UNAPPROVED", "DRAFT_REVIEW_ONLY"] }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "title",
          "source_id",
          "source_version",
          "clause",
          "pdf_page",
          "reg_page",
          "applicable_domains",
          "applicable_drawing_types",
          "conditions",
          "exceptions",
          "verbatim_excerpt",
          "verification_method",
          "confidence_default",
          "limitation",
          "approval_status"
        ],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "source_version": { "type": "string", "minLength": 1 },
          "clause": { "type": "string", "minLength": 1 },
          "pdf_page": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "reg_page": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "applicable_domains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "applicable_drawing_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "exceptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "verbatim_excerpt": { "type": "string", "minLength": 1 },
          "verification_method": { "type": "string", "minLength": 1 },
          "confidence_default": { "enum": ["HIGH", "MEDIUM", "LOW"] },
          "limitation": { "type": "string", "minLength": 1 },
          "approval_status": { "enum": ["CANDIDATE_UNAPPROVED", "DRAFT_REVIEW_ONLY"] }
        }
      }
    },
    "pack_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
