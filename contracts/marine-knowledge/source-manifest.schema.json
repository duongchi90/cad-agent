{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/marine-source-manifest-1.0",
  "title": "Marine Knowledge Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "revision",
    "status",
    "sources",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": { "const": "marine-source-manifest-1.0" },
    "manifest_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "revision": { "type": "string", "minLength": 1 },
    "status": { "enum": ["CANDIDATE_UNAPPROVED", "DRAFT_REVIEW_ONLY"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "document_kind",
          "version",
          "origin",
          "sha256",
          "page_count",
          "applicable_scope",
          "usage_rights",
          "commit_prohibited",
          "usage_status",
          "notes"
        ],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "document_kind": {
            "enum": [
              "REGULATION",
              "TEXTBOOK",
              "DRAWING_SAMPLE",
              "PRIVATE_SAMPLE",
              "ARCHIVE_BUNDLE",
              "EXCLUDED_NON_MARINE"
            ]
          },
          "version": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "page_count": { "type": ["integer", "null"], "minimum": 1 },
          "applicable_scope": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "usage_rights": {
            "enum": [
              "PUBLIC_REGULATION_NO_REDISTRIBUTION",
              "OPEN_ACADEMIC_RESEARCH",
              "PRIVATE_LOCAL_NO_COMMIT",
              "INTERNAL_FIXTURE",
              "OUT_OF_SCOPE_EXCLUDED"
            ]
          },
          "commit_prohibited": { "type": "boolean" },
          "usage_status": {
            "enum": [
              "ACTIVE_INDEXED",
              "SAMPLE_ONLY_READ_ONLY",
              "REFERENCE_METADATA_ONLY",
              "EXCLUDED_NON_MARINE"
            ]
          },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
