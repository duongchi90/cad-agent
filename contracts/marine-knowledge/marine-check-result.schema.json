{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/marine-check-result-1.0",
  "title": "Marine Domain Skill Check Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "pack_id",
    "pack_sha256",
    "pack_status",
    "cad_mutation",
    "regulatory_compliance_proven",
    "status",
    "summary",
    "observed_scope",
    "applicable_regulation_scope",
    "partial_package",
    "findings",
    "checks_executed",
    "checks_not_executed",
    "limitations",
    "proposal_only_actions"
  ],
  "properties": {
    "schema_version": { "const": "marine-check-result-1.0" },
    "skill_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "pack_id": { "type": "string", "minLength": 1 },
    "pack_sha256": { "type": ["string", "null"] },
    "pack_status": { "enum": ["CANDIDATE_UNAPPROVED", "DRAFT_REVIEW_ONLY", "DISABLED"] },
    "cad_mutation": { "const": false },
    "regulatory_compliance_proven": { "const": false },
    "status": {
      "enum": ["PASS", "CONFLICT", "INSUFFICIENT_EVIDENCE", "NOT_APPLICABLE", "DISABLED"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "observed_scope": { "type": "object" },
    "applicable_regulation_scope": { "type": "object" },
    "partial_package": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "verdict",
          "rule_id",
          "source_id",
          "source_version",
          "clause",
          "pdf_page",
          "reg_page",
          "conditions_applied",
          "exceptions_checked",
          "evidence",
          "reason",
          "confidence",
          "limitation"
        ],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["PASS", "CONFLICT", "INSUFFICIENT_EVIDENCE", "NOT_APPLICABLE"] },
          "rule_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "source_version": { "type": "string", "minLength": 1 },
          "clause": { "type": "string", "minLength": 1 },
          "pdf_page": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "reg_page": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "conditions_applied": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "exceptions_checked": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidence": { "type": "object" },
          "reason": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
          "limitation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checks_executed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "checks_not_executed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "proposal_only_actions": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
