{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/vision-handoff/vision-handoff.schema.json",
  "title": "Closed Vision Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "program_id",
    "run_id",
    "request_id",
    "created_at",
    "expires_at",
    "single_use",
    "consumed",
    "source",
    "accepted_base",
    "scope",
    "owner_intent",
    "engineering_objective",
    "dimensions",
    "protected_constraints",
    "allowed_operations",
    "forbidden_mutations",
    "workspace",
    "required_verification_gates",
    "approval_reference",
    "approval_authority",
    "instruction_sources",
    "provider_policy",
    "output_schema_id",
    "output_schema_version",
    "output_schema_sha256",
    "output_validator_version",
    "handoff_sha256"
  ],
  "properties": {
    "schema_version": {"const": "vision-handoff-1.0"},
    "handoff_id": {"$ref": "#/$defs/identifier"},
    "program_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "single_use": {"const": true},
    "consumed": {"const": false},
    "source": {"$ref": "#/$defs/fileIdentity"},
    "accepted_base": {"$ref": "#/$defs/fileIdentity"},
    "ir": {"$ref": "#/$defs/fileIdentity"},
    "drawing": {"$ref": "#/$defs/fileIdentity"},
    "evidence": {"$ref": "#/$defs/fileIdentity"},
    "revision": {"$ref": "#/$defs/fileIdentity"},
    "scope": {"$ref": "#/$defs/scope"},
    "owner_intent": {"type": "string", "minLength": 1},
    "engineering_objective": {"type": "string", "minLength": 1},
    "dimensions": {"$ref": "#/$defs/dimensions"},
    "protected_constraints": {"$ref": "#/$defs/protectedConstraints"},
    "allowed_operations": {"$ref": "#/$defs/identifierList"},
    "forbidden_mutations": {"$ref": "#/$defs/identifierList"},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "write_policy"],
      "properties": {
        "roots": {"$ref": "#/$defs/stringList"},
        "write_policy": {"const": "DISPOSABLE_ONLY"}
      }
    },
    "required_verification_gates": {"$ref": "#/$defs/identifierList"},
    "approval_reference": {"$ref": "#/$defs/identifier"},
    "approval_authority": {"enum": ["OWNER", "MASTER_PO"]},
    "instruction_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "role", "sha256"],
        "properties": {
          "source_id": {"$ref": "#/$defs/identifier"},
          "role": {"$ref": "#/$defs/identifier"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "provider_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_mode", "experimental_api", "model_identity", "config_sha256"],
      "properties": {
        "approval_mode": {"const": "deny_all"},
        "experimental_api": {"const": false},
        "model_identity": {"$ref": "#/$defs/identifier"},
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "output_schema_id": {"$ref": "#/$defs/identifier"},
    "output_schema_version": {"$ref": "#/$defs/identifier"},
    "output_schema_sha256": {"$ref": "#/$defs/sha256"},
    "output_validator_version": {"$ref": "#/$defs/identifier"},
    "handoff_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifierList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity", "sha256", "byte_length", "revision", "immutable"],
      "properties": {
        "role": {"$ref": "#/$defs/identifier"},
        "identity": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0},
        "revision": {"$ref": "#/$defs/identifier"},
        "immutable": {"const": true},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "views", "regions", "sheets", "entities"],
      "properties": {
        "components": {"$ref": "#/$defs/identifierList"},
        "views": {"$ref": "#/$defs/identifierList"},
        "regions": {"$ref": "#/$defs/identifierList"},
        "sheets": {"$ref": "#/$defs/identifierList"},
        "entities": {"$ref": "#/$defs/identifierList"}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "reference", "derived", "conflicting", "unresolved"],
      "properties": {
        "confirmed": {"$ref": "#/$defs/stringList"},
        "reference": {"$ref": "#/$defs/stringList"},
        "derived": {"$ref": "#/$defs/stringList"},
        "conflicting": {"$ref": "#/$defs/stringList"},
        "unresolved": {"$ref": "#/$defs/stringList"}
      }
    },
    "protectedConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datums", "geometry", "dimensions", "constraints", "layers", "blocks", "handles"],
      "properties": {
        "datums": {"$ref": "#/$defs/stringList"},
        "geometry": {"$ref": "#/$defs/stringList"},
        "dimensions": {"$ref": "#/$defs/stringList"},
        "constraints": {"$ref": "#/$defs/stringList"},
        "layers": {"$ref": "#/$defs/stringList"},
        "blocks": {"$ref": "#/$defs/stringList"},
        "handles": {"$ref": "#/$defs/stringList"}
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    }
  }
}
