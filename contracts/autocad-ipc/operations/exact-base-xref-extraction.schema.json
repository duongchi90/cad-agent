{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/autocad-ipc/operations/exact-base-xref-extraction.schema.json",
  "title": "CadAgent exact-base Xref extraction request parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "source_full_path",
    "source_revision",
    "inspection_expectations",
    "extraction_plan",
    "target_role",
    "candidate_output_path"
  ],
  "properties": {
    "run_id": { "$ref": "#/$defs/identifier" },
    "source_full_path": { "$ref": "#/$defs/absoluteWindowsPath" },
    "source_revision": { "$ref": "#/$defs/identifier" },
    "inspection_expectations": {
      "$ref": "exact-base-xref-inspection.schema.json#/$defs/inspectionExpectations"
    },
    "extraction_plan": { "$ref": "#/$defs/extractionPlan" },
    "target_role": { "const": "DISPOSABLE_CANDIDATE" },
    "candidate_output_path": { "$ref": "#/$defs/absoluteWindowsPath" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "absoluteWindowsPath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32767,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\)"
    },
    "lowercaseSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "bounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "min"],
      "properties": {
        "max": { "$ref": "#/$defs/point" },
        "min": { "$ref": "#/$defs/point" }
      }
    },
    "baseSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "revision", "sha256", "source_id"],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "revision": { "$ref": "#/$defs/identifier" },
        "sha256": { "$ref": "#/$defs/lowercaseSha256" },
        "source_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotation_degrees", "translation", "uniform_scale"],
      "properties": {
        "rotation_degrees": { "type": "number" },
        "translation": { "$ref": "#/$defs/translation" },
        "uniform_scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "planComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounding",
        "component_type",
        "logical_component_id",
        "provenance",
        "source_block",
        "source_handle",
        "source_layer",
        "transform"
      ],
      "properties": {
        "bounding": { "$ref": "#/$defs/bounding" },
        "component_type": { "const": "BLOCK" },
        "logical_component_id": { "$ref": "#/$defs/identifier" },
        "provenance": { "const": "REUSED_FROM_BASE_CAD" },
        "source_block": { "$ref": "#/$defs/identifier" },
        "source_handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Fa-f]+$"
        },
        "source_layer": { "$ref": "#/$defs/identifier" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "status"],
      "properties": {
        "reference": { "$ref": "#/$defs/identifier" },
        "status": { "const": "APPROVED" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "name"],
      "properties": {
        "identity": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" }
      }
    },
    "extractionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval",
        "base_source",
        "components",
        "impacted_views",
        "inspection_id",
        "plan_id",
        "provenance",
        "request_id",
        "run_id",
        "schema_version",
        "source_revision",
        "target_drawing_sha256",
        "transform_policy"
      ],
      "properties": {
        "approval": { "$ref": "#/$defs/approval" },
        "base_source": { "$ref": "#/$defs/baseSource" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/planComponent" }
        },
        "impacted_views": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/view" }
        },
        "inspection_id": { "$ref": "#/$defs/identifier" },
        "plan_id": { "$ref": "#/$defs/identifier" },
        "provenance": { "const": "REUSED_FROM_BASE_CAD" },
        "request_id": { "$ref": "#/$defs/identifier" },
        "run_id": { "$ref": "#/$defs/identifier" },
        "schema_version": { "const": "exact-base-xref-extraction-plan-1.0" },
        "source_revision": { "$ref": "#/$defs/identifier" },
        "target_drawing_sha256": { "$ref": "#/$defs/lowercaseSha256" },
        "transform_policy": {
          "const": "LOCAL_TRANSLATION_ROTATION_UNIFORM_SCALE_ONLY"
        }
      }
    }
  }
}
