{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/autocad-ipc/operations/exact-base-xref-extraction-result.schema.json",
  "title": "CadAgent exact-base Xref disposable extraction result payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_target_overwrite",
    "candidate_changed_during_operation",
    "candidate_input_path",
    "candidate_input_sha256",
    "candidate_output_path",
    "candidate_output_sha256",
    "components",
    "live_preflight",
    "plan_id",
    "request_id",
    "run_id",
    "save_performed",
    "schema_version",
    "source_handle_to_candidate_handle",
    "source_mutated",
    "source_revision",
    "source_saved",
    "source_sha256_after",
    "source_sha256_before",
    "warnings"
  ],
  "properties": {
    "accepted_target_overwrite": { "const": false },
    "candidate_changed_during_operation": { "const": true },
    "candidate_input_path": { "$ref": "#/$defs/absoluteWindowsPath" },
    "candidate_input_sha256": { "$ref": "#/$defs/lowercaseSha256" },
    "candidate_output_path": { "$ref": "#/$defs/absoluteWindowsPath" },
    "candidate_output_sha256": { "$ref": "#/$defs/lowercaseSha256" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/componentEvidence" }
    },
    "live_preflight": { "$ref": "#/$defs/livePreflight" },
    "plan_id": { "$ref": "#/$defs/identifier" },
    "request_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "save_performed": { "const": true },
    "schema_version": { "const": "exact-base-xref-extraction-result-1.0" },
    "source_handle_to_candidate_handle": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/handleMapping" }
    },
    "source_mutated": { "const": false },
    "source_revision": { "$ref": "#/$defs/identifier" },
    "source_saved": { "const": false },
    "source_sha256_after": { "$ref": "#/$defs/lowercaseSha256" },
    "source_sha256_before": { "$ref": "#/$defs/lowercaseSha256" },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "lowercaseSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absoluteWindowsPath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32767,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\)"
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotation_degrees", "translation", "uniform_scale"],
      "properties": {
        "rotation_degrees": { "type": "number" },
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "uniform_scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "handleMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_handle", "candidate_handle"],
      "properties": {
        "source_handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Fa-f]+$"
        },
        "candidate_handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Fa-f]+$"
        }
      }
    },
    "componentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_handle",
        "logical_component_id",
        "provenance",
        "source_block",
        "source_handle",
        "source_layer",
        "source_revision",
        "source_sha256",
        "transform"
      ],
      "properties": {
        "candidate_handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Fa-f]+$"
        },
        "logical_component_id": { "$ref": "#/$defs/identifier" },
        "provenance": { "const": "REUSED_FROM_BASE_CAD" },
        "source_block": { "$ref": "#/$defs/identifier" },
        "source_handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Fa-f]+$"
        },
        "source_layer": { "$ref": "#/$defs/identifier" },
        "source_revision": { "$ref": "#/$defs/identifier" },
        "source_sha256": { "$ref": "#/$defs/lowercaseSha256" },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "livePreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dbmod_after",
        "dbmod_before",
        "eligible",
        "evidence_sha256",
        "inspection_id",
        "source_sha256",
        "target_drawing_sha256",
        "xref"
      ],
      "properties": {
        "dbmod_after": { "type": "integer", "minimum": 0 },
        "dbmod_before": { "type": "integer", "minimum": 0 },
        "eligible": { "const": true },
        "evidence_sha256": { "$ref": "#/$defs/lowercaseSha256" },
        "inspection_id": { "$ref": "#/$defs/identifier" },
        "source_sha256": { "$ref": "#/$defs/lowercaseSha256" },
        "target_drawing_sha256": { "$ref": "#/$defs/lowercaseSha256" },
        "xref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "read_only", "status"],
          "properties": {
            "name": { "$ref": "#/$defs/identifier" },
            "read_only": { "const": true },
            "status": { "const": "INSPECTED" }
          }
        }
      }
    }
  }
}
