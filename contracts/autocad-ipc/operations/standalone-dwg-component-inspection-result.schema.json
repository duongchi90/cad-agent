{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/autocad-ipc/operations/standalone-dwg-component-inspection-result.schema.json",
  "title": "CadAgent standalone DWG component inspection result payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inspection_id",
    "request_id",
    "source_identity",
    "source_sha256_before",
    "source_sha256_after",
    "dbmod_before",
    "dbmod_after",
    "read_only",
    "groups",
    "warnings",
    "conflicts",
    "changed",
    "eligible",
    "inspection_sha256"
  ],
  "properties": {
    "schema_version": { "const": "standalone-dwg-component-inspection-result-1.0" },
    "inspection_id": { "$ref": "#/$defs/identifier" },
    "request_id": { "$ref": "#/$defs/identifier" },
    "source_identity": { "$ref": "#/$defs/sourceIdentity" },
    "source_sha256_before": { "$ref": "#/$defs/lowercaseSha256" },
    "source_sha256_after": { "$ref": "#/$defs/lowercaseSha256" },
    "dbmod_before": { "type": "integer", "minimum": 0 },
    "dbmod_after": { "type": "integer", "minimum": 0 },
    "read_only": { "const": true },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inspectionGroup" }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "changed": { "type": "boolean" },
    "eligible": { "type": "boolean" },
    "inspection_sha256": { "$ref": "#/$defs/lowercaseSha256" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "absoluteWindowsPath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32767,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\)"
    },
    "lowercaseSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hexHandle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Fa-f]+$"
    },
    "layerName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "dbmod"],
      "properties": {
        "path": { "$ref": "#/$defs/absoluteWindowsPath" },
        "sha256": { "$ref": "#/$defs/lowercaseSha256" },
        "dbmod": { "type": "integer", "minimum": 0 },
        "xref_count": { "type": "integer", "minimum": 0 }
      }
    },
    "inspectionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "logical_component_id",
        "source_handles",
        "entity_types",
        "layers",
        "signature_sha256"
      ],
      "properties": {
        "group_id": { "$ref": "#/$defs/identifier" },
        "logical_component_id": { "$ref": "#/$defs/identifier" },
        "source_handles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hexHandle" }
        },
        "entity_types": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/layerName" }
        },
        "signature_sha256": { "$ref": "#/$defs/lowercaseSha256" }
      }
    }
  }
}
