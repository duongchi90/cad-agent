{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/autocad-ipc/result.schema.json",
  "title": "CadAgent AutoCAD .NET IPC result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "success",
    "operation",
    "drawing_full_path",
    "changed",
    "entity_handles",
    "warnings",
    "errors",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "success": {
      "type": "boolean"
    },
    "operation": {
      "enum": [
        "health",
        "review",
        "close_disposable",
        "mechanical_bom",
        "drawing_setup_audit",
        "visual_evidence_export",
        "native_render_evidence",
        "exact_base_xref_inspection",
        "exact_base_xref_extraction"
      ]
    },
    "drawing_full_path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\)"
    },
    "changed": {
      "type": "boolean"
    },
    "entity_handles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "review"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "close_disposable"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "mechanical_bom"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "drawing_setup_audit"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "changed": {
            "const": false
          },
          "entity_handles": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "visual_evidence_export"
          },
          "success": {
            "const": true
          }
        },
        "required": [
          "operation",
          "success"
        ]
      },
      "then": {
        "required": [
          "payload"
        ],
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "changed": {
            "const": false
          },
          "entity_handles": {
            "maxItems": 0
          },
          "payload": {
            "$ref": "operations/visual-evidence-export-result.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "native_render_evidence"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "changed": {
            "const": false
          },
          "entity_handles": {
            "maxItems": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "success": {
                  "const": true
                }
              },
              "required": [
                "success"
              ]
            },
            "then": {
              "required": [
                "payload"
              ],
              "properties": {
                "payload": {
                  "$ref": "operations/native-render-evidence-result.schema.json"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "success": {
                  "const": false
                }
              },
              "required": [
                "success"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "maxProperties": 0
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "exact_base_xref_inspection"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "changed": {
            "const": false
          },
          "entity_handles": {
            "maxItems": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "success": {
                  "const": true
                }
              },
              "required": [
                "success"
              ]
            },
            "then": {
              "required": [
                "payload"
              ],
              "properties": {
                "payload": {
                  "$ref": "operations/exact-base-xref-inspection-result.schema.json"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "success": {
                  "const": false
                }
              },
              "required": [
                "success"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "maxProperties": 0
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "exact_base_xref_extraction"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "success": {
                  "const": true
                }
              },
              "required": [
                "success"
              ]
            },
            "then": {
              "required": [
                "payload"
              ],
              "properties": {
                "changed": {
                  "const": true
                },
                "entity_handles": {
                  "minItems": 1
                },
                "payload": {
                  "$ref": "operations/exact-base-xref-extraction-result.schema.json"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "success": {
                  "const": false
                }
              },
              "required": [
                "success"
              ]
            },
            "then": {
              "properties": {
                "changed": {
                  "const": false
                },
                "entity_handles": {
                  "maxItems": 0
                },
                "payload": {
                  "type": "object",
                  "maxProperties": 0
                }
              }
            }
          }
        ]
      }
    }
  ]
}
