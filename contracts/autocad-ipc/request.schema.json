{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/contracts/autocad-ipc/request.schema.json",
  "title": "CadAgent AutoCAD .NET IPC request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "schema_version",
    "operation",
    "drawing_full_path",
    "drawing_sha256",
    "parameters",
    "approval"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "schema_version": {
      "const": "1.0"
    },
    "operation": {
      "enum": [
        "health",
        "review",
        "close_disposable",
        "mechanical_bom",
        "drawing_setup_audit",
        "visual_evidence_export",
        "native_render_evidence",
        "exact_base_xref_inspection",
        "exact_base_xref_extraction"
      ]
    },
    "drawing_full_path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\)"
    },
    "drawing_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "parameters": {
      "type": "object"
    },
    "approval": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "health"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "$ref": "operations/health.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "review"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "parameters": {
            "$ref": "operations/review.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "close_disposable"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "parameters": {
            "$ref": "operations/close-disposable.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "mechanical_bom"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "parameters": {
            "$ref": "operations/mechanical-bom.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "drawing_setup_audit"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "parameters": {
            "$ref": "operations/drawing-setup-audit.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "visual_evidence_export"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "drawing_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "parameters": {
            "$ref": "operations/visual-evidence-export.schema.json"
          },
          "approval": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "native_render_evidence"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "drawing_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "parameters": {
            "$ref": "operations/native-render-evidence.schema.json"
          },
          "approval": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "exact_base_xref_inspection"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "drawing_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "parameters": {
            "$ref": "operations/exact-base-xref-inspection.schema.json"
          },
          "approval": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "exact_base_xref_extraction"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "drawing_full_path": {
            "type": "string"
          },
          "drawing_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "parameters": {
            "$ref": "operations/exact-base-xref-extraction.schema.json"
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "status"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "status": {
                "const": "APPROVED"
              }
            }
          }
        }
      }
    }
  ]
}
